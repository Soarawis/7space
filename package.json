{
  "name": "techspace-website",
  "version": "1.0.0",
  "description": "TechSpace - เว็บไซต์เทคโนโลยีด้วย Tailwind CSS v4 (CLI)",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css",
    "watch": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --watch",
    "dev": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
